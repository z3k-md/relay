{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "mainBinaryName": "relay-desktop",
  "version": "0.1.10",
  "identifier": "dev.relay.desktop",
  "build": {
    "beforeDevCommand": "bun run frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Relay",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Realtime file sync for your machines",
    "longDescription": "Relay keeps the folders you choose in sync across your computers. Files stay local. No cloud account.",
    "homepage": "https://github.com/z3k-md/relay",
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "externalBin": ["binaries/relay"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQ0I2NEY1MDFDMDlCMkQKUldRdG04QUI5V1RMLzhvZmlKQTdlYmlKeERuMUpONVhESDhWam90OEJBVWQ2bW1KQ215VE5FVkwK",
      "endpoints": [
        "https://github.com/z3k-md/relay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
