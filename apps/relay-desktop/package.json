{
  "name": "relay-desktop",
  "description": "Realtime file sync for your machines",
  "private": true,
  "version": "0.1.10",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "bun run sidecar && tauri dev",
    "build": "bun run sidecar && tauri build",
    "sidecar": "bash scripts/prepare-sidecar.sh",
    "frontend": "vite",
    "frontend:build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.39",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
